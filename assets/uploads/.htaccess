# Uploaded photos only. Never run scripts from here, even if someone
# manages to upload one with a sneaky name.
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes -ExecCGI
